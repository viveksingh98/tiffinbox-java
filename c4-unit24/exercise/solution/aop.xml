<!DOCTYPE aspectj PUBLIC "-//AspectJ//DTD//EN" "https://eclipse.dev/aspectj/dtd/aspectj.dtd">
<aspectj>
  <aspects>
    <aspect name="com.tiffinbox.Counter"/>
  </aspects>
  <!-- -showWeaveInfo: one "weaveinfo ... Join point 'method-execution(int com.tiffinbox.Kitchen.price(..))'"
       line per method woven. Verified: 1 line, and priceTwice(): advice ran 2. -->
  <weaver options="-showWeaveInfo">
    <include within="com.tiffinbox..*"/>   <!-- Kitchen is in com.tiffinbox, not a kitchen sub-package -->
  </weaver>
</aspectj>
