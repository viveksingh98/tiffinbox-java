<?xml version="1.0" encoding="UTF-8"?>
<!--
  The harness's, never TiffinBox's: a POM with no code whose one job is to resolve two jars into this unit's repository, .m2-demo -
  Boot's web-server module and its Tomcat module, each alone (every transitive dependency excluded). receipts.sh's analyzers
  capture reads their META-INF/spring.factories, where Boot's port analyzer is named; TiffinBox ships neither. receipts.sh runs it
  from a copy under .harness/, offline first, as every build here (a fresh clone's .m2-demo does not hold them).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>probe</groupId>
    <artifactId>boot-server-jars</artifactId>
    <version>1</version>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-tomcat</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
