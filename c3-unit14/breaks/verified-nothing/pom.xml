<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tiffinbox</groupId>
  <artifactId>verified-nothing-break</artifactId>
  <version>1.0.0</version>
  <name>Break: a verified mock that proves nothing</name>
  <description>One test passes. One test tells you why that means nothing.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    The BOM, not the library. junit-bom decides ONE version for the whole JUnit family;
    every JUnit dependency below then carries no <version> of its own and cannot drift
    apart from its siblings. In the JUnit 5 line the Jupiter artifacts were 5.x while the
    Platform artifacts were 1.x - two numbers to keep straight. In this line they are one.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- test scope: on the classpath when tests compile and run, in no shipped jar -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      3.27.7 is the newest GA, read off the VERSION LIST. Maven Central's <release> field for
      this artifact says 4.0.0-M1, which is a milestone - and that milestone was published on
      2025-03-09, ten months BEFORE 3.27.7 (2026-01-24). <release> is just the LAST ENTRY of the
      <versions> list, and that list is in VERSION order, major number first - not text order
      (3.9.1 sits before 3.10.0) and not publication order. So a 4.x milestone outranks the
      newest 3.x GA, and the field has no idea which one is newer in time. Pin the newest GA.
      AssertJ has no BOM, so the version is pinned here, on the artifact.
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>

    <!--
      Mockito has no BOM either, so both artifacts are pinned. mockito-junit-jupiter is the
      bridge that gives you @Mock and MockitoExtension; it DECLARES junit-jupiter-api 5.13.4,
      and the junit-bom above manages that up to 6.1.3. dependency:tree -Dverbose says so in
      as many words. It works on this pair - that is measured, not promised.
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.23.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.23.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <!--
        Pin surefire. Without this line Maven binds its own default - 3.5.4 on Maven 3.9.16 -
        and the version that runs your tests is decided by which Maven you happen to have.
      -->
      <!-- STATIC-AGENT-BEGIN
           The two blocks this unit adds. Delete everything between this marker and the
           closing one below, run the project again, and read what the JVM says. That is
           exactly what receipts.sh warn does, to a throwaway copy. -->
      <!--
        This plugin's properties goal sets one Maven property per resolved dependency, named
        after its coordinates. That is the only reason ${org.mockito:mockito-core:jar} below
        expands to a real path - nothing else in Maven knows where that jar landed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <goals><goal>properties</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!--
            Mockito loads its inline mock maker by attaching an agent to the running JVM. Left
            to itself it attaches to ITSELF at run time, and the JDK says so - loudly. Declaring
            mockito-core as a static -javaagent means the agent is on the command line before
            the JVM starts, and there is nothing to warn about.

            Read receipts.sh warn before you assume this makes the output silent. It does not.
            One line survives, it is a different warning with a different cause, and no flag
            removes it.
          -->
          <!--
            The quotes around the property are load bearing. Surefire splits argLine on
            whitespace, and this repository's path contains a space, so without them the fork
            is launched with -javaagent:/Users/you/Downloads/Youtube and the JVM dies before
            a single test runs: "Error occurred during initialization of VM", reported by
            surefire as "The forked VM terminated without properly saying goodbye."
          -->
          <argLine>-javaagent:"${org.mockito:mockito-core:jar}"</argLine>
        </configuration>
      </plugin>
      <!-- STATIC-AGENT-END -->
    </plugins>
  </build>
</project>
