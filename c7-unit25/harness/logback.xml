<configuration>
  <!-- Unit 25's harness (unit 23's form): one line per event - level, logger, message - and no stack trace (%nopex: the harness
       prints an exception's class, message, causes and SQLState itself). Hibernate's SQL logger (DEBUG); Boot's
       JpaTransactionManager (DEBUG: the line that names the isolation level, S4.1's first witness); Hibernate's core logger at INFO
       for HHH000001 (S4.13); the EntityManagerFactory's bean and Spring Data's scan at INFO; the rest at WARN. No thread name is
       printed: the latches order the two threads of `context`, so the log's order is the latches'. Micrometer's AbstractTimer at ERROR:
       its one-off WARN "'amount' should not be negative" (a clock reading taken across threads) appeared once in a development run of
       `context` and drifted the capture; no beat reads it. -->
  <appender name="O" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level %logger : %msg%n%nopex</pattern></encoder>
  </appender>
  <logger name="org.hibernate.SQL" level="DEBUG"/>
  <logger name="org.springframework.orm.jpa.JpaTransactionManager" level="DEBUG"/>
  <logger name="org.hibernate.orm.core" level="INFO"/>
  <logger name="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean" level="INFO"/>
  <logger name="org.springframework.data.repository.config.RepositoryConfigurationDelegate" level="INFO"/>
  <logger name="io.micrometer.core.instrument.AbstractTimer" level="ERROR"/>
  <root level="WARN"><appender-ref ref="O"/></root>
</configuration>
