<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    THE HARNESS'S JARS - the course's, never TiffinBox's. This POM builds nothing: its one job is to name, by exact version,
    every file this lesson reads beside TiffinBox's own jars, so that Maven fetches them (on a fresh clone, once) and copies
    them into two folders, never by hand:
      target/old  - the last Boot 3: Boot 3.5.16's autoconfigure, actuator and actuator-autoconfigure jars, its BOM and its
                    Compose module's POM, and Framework 6.2.19's spring-context (the 6.2.x that Boot 3.5.16 manages)
      target/new  - what TiffinBox does not ship of Boot 4.1.1 and Framework 7.0.9: the BOM, the Compose module's POM, Boot's
                    Jackson module, Jackson 3's databind POM, spring-web, and Boot's properties migrator with the metadata
                    jar it needs
    Every version is written out, never managed: the comparison is between these exact files. The parent only supplies the
    dependency plugin's version (the one TiffinBox's own builds use).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>probe.harness</groupId>
  <artifactId>old-and-new-jars</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>old</id>
            <phase>validate</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/old</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><version>3.5.16</version></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-actuator</artifactId><version>3.5.16</version></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-actuator-autoconfigure</artifactId><version>3.5.16</version></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>3.5.16</version><type>pom</type></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-docker-compose</artifactId><version>3.5.16</version><type>pom</type></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>6.2.19</version></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>new</id>
            <phase>validate</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/new</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>4.1.1</version><type>pom</type></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-docker-compose</artifactId><version>4.1.1</version><type>pom</type></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-jackson</artifactId><version>4.1.1</version></artifactItem>
                <artifactItem><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>3.1.5</version><type>pom</type></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-properties-migrator</artifactId><version>4.1.1</version></artifactItem>
                <artifactItem><groupId>org.springframework.boot</groupId><artifactId>spring-boot-configuration-metadata</artifactId><version>4.1.1</version></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
