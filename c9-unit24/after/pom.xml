<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The parent builds nothing. Its packaging is pom, so there is no src/ and no jar. -->
  <!-- Course 5, unit 01: TiffinBox inherits Boot's parent. It brings dependency management (every Boot-managed
       version), plugin management (including a repackage it does NOT bind here) and -parameters. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Course 7, unit 03: 4.1.2, Spring Boot's newest release on the day (Spring Framework 7.0.10, Hibernate ORM 7.4.13.Final
         with the data starter). Moved at the course boundary and measured on its own before the starter joined: the same
         eighteen tests, the same seven answers, the same messages (../c7-unit03, move).
         Course 9, unit 04: 4.1.3 since - the comment below. -->
    <version>4.1.3</version>
    <!-- Course 9, unit 04: 4.1.3 (Spring Framework 7.0.11), moved for two advisories against 4.1.2's Spring Data: CVE-2026-123886 (HIGH)
         and CVE-2026-59342 (MEDIUM), fixed by 4.1.3's Spring Data 2026.0.3 (Elasticsearch 6.1.3, MongoDB 5.1.3). Measured on its own
         first - the version step alone, then the key (../c9-unit04, tests and inert). -->
    <relativePath/>
  </parent>

  <groupId>com.tiffinbox</groupId>
  <artifactId>tiffinbox-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>TiffinBox</name>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <h2.version>2.5.250</h2.version>
    <!-- Course 9, unit 04: Tomcat 11.0.29 over the parent's 11.0.27 - Tomcat's ten advisories after 11.0.27, four of them Important
         (CVE-2026-116600, CVE-2026-116830, CVE-2026-118028, CVE-2026-121649; tomcat.apache.org/security-11.html). Netty 4.2.20.Final
         comes with the parent. -->
    <tomcat.version>11.0.29</tomcat.version>
    <!-- Course 9, unit 05: Parsson, the JSON-P implementation the PATCH route applies merge patches and JSON Patches with - Boot's BOM
         manages JSON-P's API (jakarta-json.version) but not Parsson, so its version is pinned here, once: the one the Elasticsearch
         client already brought (../c9-unit05, jsonp). -->
    <parsson.version>1.1.9</parsson.version>
    <!-- Course 9, unit 07: springdoc-openapi, outside Boot's BOM, so its version is pinned here, once (S9.7). What this pin rests
         on, and nothing wider: springdoc 3.2.1's own POM names Spring Boot 4.2.0 as its parent (springdoc-openapi-3.2.1.pom:13)
         while this tree runs 4.1.3; the two earlier lines on Central, 3.1.0 and 3.1.1, were not weighed (the course's Maven seed
         holds 3.2.1 only, and a weighing needs a network read); what was measured is this tree with it - /v3/api-docs answering,
         45 tests, the seven and the old surface byte-identical - by ../c9-unit07's receipts. Versioned routes (Framework 7.0's
         API versioning) are not measured here: Versioning Strategies prints what they do to this pin. -->
    <springdoc.version>3.2.1</springdoc.version>
    <!-- Course 9, unit 10: openapi-generator's Maven build step, outside Boot's BOM, so its version is pinned here, once (S9.7). What this
         pin rests on, and nothing wider: 7.27.0 is the newest the course's sweep found on Central (S2-PROBE-NOTES, the versions table);
         the earlier lines were not weighed (the course's Maven seed holds 7.27.0 only, and a weighing needs a network read); what was
         measured is this spec through this generator and its spring-http-interface library - the module tiffinbox-client generated from
         the committed file, its interface bound to MockRestServiceServer, one real call - by ../c9-unit10's receipts. Version-bound: the
         receipts are recorded again when this pin moves. -->
    <openapi-generator.version>7.27.0</openapi-generator.version>
    <!-- Course 9, unit 11: Asciidoctor's Maven build step, outside Boot's BOM, so its version is pinned here, once (S9.7). What this pin
         rests on, and nothing wider: 3.2.0 is the newest the course's sweep found on Central (S2-PROBE-NOTES, the versions table); not
         weighed: the earlier lines, asciidoctorj 3.0.1 (newer than the 3.0.0 this step resolves) and REST Docs 4.1.0 (Boot 4.1.3 manages
         4.0.3) - the course's Maven seed holds these versions only, and a weighing needs a network read; what was measured is this tree's
         snippets through this step to an HTML page read as a file in a sealed browser, the passing test and the failure kinds, by
         ../c9-unit11's receipts. Version-bound: the receipts are recorded again when this pin moves. -->
    <asciidoctor-maven-plugin.version>3.2.0</asciidoctor-maven-plugin.version>
    <!-- Course 9, unit 19: Bucket4j, the token bucket behind the rate limit (RateLimitFilter), outside Boot's BOM, so its version is
         pinned here, once (S9.7). What this pin rests on, and nothing wider: 8.23.0 is the newest the course's sweep found on Central
         (2026-11-27, the Section 4 probe); the earlier lines were not weighed (the course's Maven seed holds 8.23.0 only, and a weighing
         needs a network read); its lettuce module declares Lettuce 6.1.8.RELEASE as provided, and Boot's parent resolves 7.5.2.RELEASE.
         What was measured is this tree with it - the bucket in the JVM on the default run, and two JVMs on one Redis bucket under the
         profile "dev" - by ../c9-unit19's receipts. Version-bound: the receipts are recorded again when this pin moves. -->
    <bucket4j.version>8.23.0</bucket4j.version>
    <!-- Course 5: one fixed time for every entry of every archive this build writes - Course 3's reproducible-build
         exercise, landed in the anchor. Without it each jar entry carries the clock of its own build, so tiffinbox-core's
         jar - and with it the application layer of Boot's jar - changed on every build, even with no change at all. With
         it, two clean builds of the same sources in one time zone give the same bytes, and the same four layers
         (another zone changes 8 entries' NTFS time field: ../c5-unit14, capture moved). -->
    <project.build.outputTimestamp>2026-09-15T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <modules>
    <module>tiffinbox-core</module>
    <module>tiffinbox-web</module>
    <module>tiffinbox-client</module>
  </modules>

  <!--
    Versions live here and nowhere else. dependencyManagement does NOT add a dependency to
    anything; it only decides the version a child gets when the child names an artifact
    without one. ${project.version} keeps the two sibling modules on the same number.
  -->
  <dependencyManagement>
    <dependencies>
      <!-- Course 5: the Spring versions now come from the parent (spring-boot-starter-parent imports
           spring-boot-dependencies, which manages Spring Framework 7.0.9). The Framework BOM import is gone.
           Course 7, unit 03: Spring Framework 7.0.10 since the parent's move to 4.1.2. Course 9, unit 04: 7.0.11, with 4.1.3. -->
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>3.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.tiffinbox</groupId>
        <artifactId>tiffinbox-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- The same idea for plugins: the version is here, the binding is in the child. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <!-- Course 5: Boot's configuration processor writes META-INF/spring-configuration-metadata.json, the file an IDE
               reads to complete and describe the keys of a @ConfigurationProperties class. It is named on the processor
               path, not added as a dependency: on JDK 25, javac skips a processor it finds only on the class path unless
               processing is switched on (-proc:full), and says nothing. No version: Boot's parent manages it. Declared
               here, so it runs in every module - the record lives in tiffinbox-core. -->
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
