<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tiffinbox</groupId>
    <artifactId>tiffinbox-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>tiffinbox-web</artifactId>
  <name>TiffinBox Web</name>
  <description>Spring MVC's routes over TiffinBox's core. No SQL in here.</description>

  <!-- Course 6: Surefire runs the tests in a JVM of its own (a fork), and passes it this property's options: Maven's own
       (MAVEN_OPTS) never reach it. The locale pinned there, as on every run line - Hibernate Validator writes its messages
       in the JVM's language, and a test asserts en_US. -->
  <properties>
    <argLine>-Duser.language=en -Duser.country=US</argLine>
  </properties>

  <dependencies>
    <!-- No version: the parent manages it. Course 6: Jackson 2's jackson-databind, beside it since Core Java II, is gone -
         Spring MVC's Jackson 3 reads and writes every JSON body TiffinBox sends or receives. -->
    <dependency>
      <groupId>com.tiffinbox</groupId>
      <artifactId>tiffinbox-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Course 5: Bean Validation for TiffinBoxProperties - Hibernate Validator (the implementation), the API it
         implements, and spring-boot-validation, whose own imports file adds ValidationAutoConfiguration. Without an
         implementation, the API jar alone (which tiffinbox-core brings) stops the start even with a good configuration. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Course 5: Boot's Docker Compose support, for development only - optional, so Boot's plugin leaves it out of
         the executable jar (its includeOptional is off), and with it the Jackson 3 it brings; the plugin's
         excludeDockerCompose, on, would keep the module out even then. It runs from a class path that holds it,
         and only with the profile "dev": application.yaml switches it off. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Course 5: Boot's Actuator - endpoints that report on the running application, health first, and Micrometer
         for its metrics. Course 6: with Spring MVC below, TiffinBox is the web application Boot's HTTP side of Actuator
         waits for, and Boot's own adapter answers them under /actuator (Course 5's ActuatorRoutes is gone). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Course 5: Micrometer's Prometheus registry. Actuator's starter brings Micrometer with a registry that keeps every
         meter in memory and offers no format to read it in; this one keeps them for Prometheus, whose server pulls
         them over HTTP (a scrape: nothing leaves TiffinBox unless it is asked), and it gives Actuator its prometheus
         endpoint. Boot's parent manages its version. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Course 6: Spring MVC and the server it runs on - embedded Tomcat, Spring's DispatcherServlet, and Jackson 3, the
         one JSON library left: it reads TiffinBox's request bodies and writes every answer (TiffinBox's routes', an error
         body, Actuator's). Boot's parent manages its version. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Course 6: Thymeleaf, through Boot's starter - a template engine: it fills an HTML file's th:* attributes from the
         model a @Controller hands it, on the server, so a client that asks for HTML gets a finished page. Boot's module
         configures the engine and a view resolver for classpath:/templates/*.html. Boot's parent manages its version. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- Course 6: TiffinBox's tests, in src/test. Test scope: on the tests' class path only - the executable jar holds the
         same libraries without it. Boot's starter brings JUnit, AssertJ, Mockito, spring-test (MockMvc, @MockitoBean,
         RestTestClient) and Boot's test modules (@WebMvcTest, @SpringBootTest). Boot's parent manages its version. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Course 5: Boot's plugin, declared bare - no version, no execution. Boot's parent manages both, and declaring
           the plugin is what binds its repackage goal to package: the jar becomes Boot's executable jar, a jar of jars -
           TiffinBox's classes under BOOT-INF/classes, every jar it needs under BOOT-INF/lib, kept whole, and Boot's
           launcher at the top. The run command is unchanged. Gone with it: the jar plugin's Main-Class/Class-Path manifest
           and the copy-dependencies execution that filled target/lib - a Class-Path header survives repackage, and makes
           the jar load the classes it names from a lib/ folder beside it, whatever version sits there. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- Course 5: Spring's ahead-of-time step (process-aot, the profile native) reads Maven's class path, not the
             jar's - with the optional Docker Compose module. This exclude keeps it out of that step, as the native
             plugin's exclusion keeps it out of the binary. Course 6: the two Jackson 3 excludes beside it are gone. Course
             5 needed them because the Compose module's Jackson 3 reached that step but not the jar; Spring MVC's starter
             puts Jackson 3 in the jar, so the step, the jar and the binary hold the same Jackson again. -->
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-docker-compose</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Course 5: GraalVM's Native Build Tools plugin, declared bare - no version, no execution. Boot's parent manages
           its version, 1.1.8 (Course 3 pinned 1.1.13 by hand). Boot's parent's profile "native" already runs Boot's
           process-aot, Spring's ahead-of-time step; with the plugin declared it also runs add-reachability-metadata, and
           this module gets native:compile-no-fork, which builds the binary from this module's classes and Maven's class
           path. From the root, native:compile fails on the parent POM: run it on this module alone. -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <!-- Course 5: the plugin builds the binary from Maven's class path, not from the jar's - with the optional Docker
             Compose module, which the executable jar leaves out. This exclusion keeps it out of the binary too. Course 6:
             the two Jackson 3 exclusions are gone - Spring MVC's starter puts Jackson 3 in the jar, and in the binary. -->
        <configuration>
          <exclusions>
            <exclusion>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-docker-compose</artifactId>
            </exclusion>
          </exclusions>
        </configuration>
      </plugin>

      <!-- exec:exec forks a real JVM. It no longer has to pass the preview flag. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>com.tiffinbox.web.TiffinBoxServer</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
