<configuration>
  <!-- Unit 32's harness: one line per event - level, thread, logger, message - and no stack trace (%nopex: the harness prints an
       exception's class, message and causes itself). Hibernate's SQL logger (DEBUG; probe.k.Main attaches the counting appender to it
       in code), Hibernate's core logger at INFO for HHH000001 (S4.13), Spring Data's scan at INFO, the rest at WARN - so the cache's
       WARN lines (org.hibernate.orm.cache, HHH90001006) are printed, and counted. The JVM's own warnings go to stderr, not here. -->
  <appender name="O" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level [%thread] %logger : %msg%n%nopex</pattern></encoder>
  </appender>
  <logger name="org.hibernate.SQL" level="DEBUG"/>
  <logger name="org.hibernate.orm.core" level="INFO"/>
  <logger name="org.hibernate.orm.cache" level="WARN"/>
  <logger name="org.springframework.data.repository.config.RepositoryConfigurationDelegate" level="INFO"/>
  <root level="WARN"><appender-ref ref="O"/></root>
</configuration>
