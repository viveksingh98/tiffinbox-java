<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tiffinbox</groupId>
  <artifactId>tiffinbox-core</artifactId>
  <version>1.0.0</version>
  <name>TiffinBox Core</name>
  <description>The unit whose subject is the failure message. AssertJ 3.27.7 beside JUnit's own assertions.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    The BOM, not the library. junit-bom decides ONE version for the whole JUnit family;
    every JUnit dependency below then carries no <version> of its own and cannot drift
    apart from its siblings. In the JUnit 5 line the Jupiter artifacts were 5.x while the
    Platform artifacts were 1.x - two numbers to keep straight. In this line they are one.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.250</version>
    </dependency>

    <!-- test scope: on the classpath when tests compile and run, in no shipped jar -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      3.27.7 is the newest GA, read off the VERSION LIST. Maven Central's <release> field for
      this artifact says 4.0.0-M1, which is a milestone - and that milestone was published on
      2025-03-09, ten months BEFORE 3.27.7 (2026-01-24). Central's <release> is just the LAST
      ENTRY of that list, and the list is in version order - major number first - so a 4.x
      milestone outranks the newest 3.x GA, and nothing in it is sorted by date. Pin the newest
      GA. ./receipts.sh release derives all of this from central/, offline.
      AssertJ has no BOM, so the version is pinned here, on the artifact.
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <!--
        Pin surefire. Without this line Maven binds its own default - 3.5.4 on Maven 3.9.16 -
        and the version that runs your tests is decided by which Maven you happen to have.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
    </plugins>
  </build>
</project>
