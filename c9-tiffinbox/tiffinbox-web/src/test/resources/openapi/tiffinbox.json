              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "customer-not-found": {
                    "description": "customer-not-found",
                    "value": {
                      "detail": "no customer named Nobody",
                      "instance": "/api/v1/customers/Nobody",
                      "status": 404,
                      "title": "Customer not found",
                      "type": "tag:tiffinbox.example,2026:customer-not-found",
                      "name": "Nobody"
