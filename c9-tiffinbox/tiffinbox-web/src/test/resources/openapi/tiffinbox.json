{
  "openapi": "3.1.0",
  "info": {
    "title": "TiffinBox",
    "version": "1.0"
  },
  "paths": {
    "/shutdown": {
      "post": {
        "tags": [
          "tiffin-box-server"
        ],
        "operationId": "shutdown",
        "parameters": [
          {
            "name": "X-Shutdown-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "tags": [
          "tiffin-box-server"
        ],
        "operationId": "customers",
        "parameters": [
          {
            "name": "mealType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "VEG",
                "NON_VEG",
                "VEGAN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Customer"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tiffin-box-server"
        ],
        "operationId": "add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Customer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Idempotency-Key is malformed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-malformed": {
                    "description": "idempotency-key-malformed",
                    "value": {
                      "detail": "The Idempotency-Key header must be one String of 1 to 255 characters from A-Z, a-z, 0-9 and - . _ ~, with no parameters.",
                      "status": 400,
                      "title": "Idempotency-Key is malformed",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-malformed"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A request is outstanding for this Idempotency-Key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-outstanding": {
                    "description": "idempotency-key-outstanding",
                    "value": {
                      "detail": "A request with this Idempotency-Key is still being processed. Retry it later with the same key.",
                      "status": 409,
                      "title": "A request is outstanding for this Idempotency-Key",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-outstanding"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Idempotency-Key is already used",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-reused": {
                    "description": "idempotency-key-reused",
                    "value": {
                      "detail": "This Idempotency-Key was first used with a different request. Use a new key for a new request.",
                      "status": 422,
                      "title": "Idempotency-Key is already used",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-reused"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/import": {
      "post": {
        "tags": [
          "customer-import"
        ],
        "operationId": "importCsv",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers/{name}/pauses": {
      "post": {
        "tags": [
          "customer-pauses"
        ],
        "operationId": "add_1",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "400": {
            "description": "Idempotency-Key is missing or malformed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-missing": {
                    "description": "idempotency-key-missing",
                    "value": {
                      "detail": "This operation requires an Idempotency-Key header: one String of 1 to 255 characters from A-Z, a-z, 0-9 and - . _ ~, with no parameters.",
                      "status": 400,
                      "title": "Idempotency-Key is missing",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-missing"
                    }
                  },
                  "idempotency-key-malformed": {
                    "description": "idempotency-key-malformed",
                    "value": {
                      "detail": "The Idempotency-Key header must be one String of 1 to 255 characters from A-Z, a-z, 0-9 and - . _ ~, with no parameters.",
                      "status": 400,
                      "title": "Idempotency-Key is malformed",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-malformed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "customer-not-found": {
                    "description": "customer-not-found",
                    "value": {
                      "detail": "no customer named Nobody",
                      "instance": "/api/v1/customers/Nobody/pauses",
                      "status": 404,
                      "title": "Customer not found",
                      "type": "tag:tiffinbox.example,2026:customer-not-found",
                      "name": "Nobody"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A request is outstanding for this Idempotency-Key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-outstanding": {
                    "description": "idempotency-key-outstanding",
                    "value": {
                      "detail": "A request with this Idempotency-Key is still being processed. Retry it later with the same key.",
                      "status": 409,
                      "title": "A request is outstanding for this Idempotency-Key",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-outstanding"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Idempotency-Key is already used",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "idempotency-key-reused": {
                    "description": "idempotency-key-reused",
                    "value": {
                      "detail": "This Idempotency-Key was first used with a different request. Use a new key for a new request.",
                      "status": 422,
                      "title": "Idempotency-Key is already used",
                      "type": "tag:tiffinbox.example,2026:idempotency-key-reused"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
