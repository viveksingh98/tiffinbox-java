  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "mealsPerDay": {
            "type": "integer",
            "format": "int32",
            "maximum": 3,
            "minimum": 1
          },
          "pricePerMeal": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "mealType": {
            "type": "string",
            "pattern": "VEG|NON_VEG|VEGAN"
          }
        },
        "required": [
          "mealType",
          "name"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "SseEmitter": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
