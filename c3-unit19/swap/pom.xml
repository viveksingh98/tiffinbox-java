<?xml version="1.0" encoding="UTF-8"?>
<!--
  THE SAME SOURCE, A DIFFERENT BINDING.

  swap/src/main/java is byte-for-byte identical to ../src/main/java - ./receipts.sh swap
  hashes both trees and prints the two values side by side. The ONE difference in this
  whole project is four lines below: slf4j-simple instead of logback-classic.

  There is no logback.xml here, because there is no Logback here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tiffinbox</groupId>
  <artifactId>tiffinbox-core-simple</artifactId>
  <version>1.0.0</version>
  <name>TiffinBox Core (slf4j-simple binding)</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.250</version>
    </dependency>

    <!-- the binding, and the only line that differs from ../pom.xml -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.19</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk-platform-logging</artifactId>
      <version>2.0.19</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>com.tiffinbox.kitchen.KitchenLog</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
