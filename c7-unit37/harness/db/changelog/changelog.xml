<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="1" author="tiffinbox">
    <createTable tableName="customer">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="name" type="VARCHAR(60)"><constraints nullable="false" unique="true"/></column>
      <column name="meals_per_day" type="INT"><constraints nullable="false"/></column>
      <column name="price_per_meal" type="INT"><constraints nullable="false"/></column>
      <column name="meal_type" type="VARCHAR(10)"><constraints nullable="false"/></column>
      <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
    </createTable>
    <createTable tableName="pause">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="customer_id" type="BIGINT"><constraints nullable="false" references="customer(id)" foreignKeyName="pause_customer_id_fkey"/></column>
      <column name="days" type="INT"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="pause" indexName="pause_customer_id_idx"><column name="customer_id"/></createIndex>
  </changeSet>
  <changeSet id="2" author="tiffinbox">
    <insert tableName="customer"><column name="name" value="Ravi"/><column name="meals_per_day" valueNumeric="2"/><column name="price_per_meal" valueNumeric="120"/><column name="meal_type" value="VEG"/></insert>
    <insert tableName="customer"><column name="name" value="Meera"/><column name="meals_per_day" valueNumeric="1"/><column name="price_per_meal" valueNumeric="150"/><column name="meal_type" value="NON_VEG"/></insert>
    <insert tableName="customer"><column name="name" value="Sunil"/><column name="meals_per_day" valueNumeric="3"/><column name="price_per_meal" valueNumeric="100"/><column name="meal_type" value="VEG"/></insert>
    <insert tableName="customer"><column name="name" value="Priya"/><column name="meals_per_day" valueNumeric="1"/><column name="price_per_meal" valueNumeric="120"/><column name="meal_type" value="VEGAN"/></insert>
    <sql>INSERT INTO pause (customer_id, days) SELECT id, 3 FROM customer WHERE name = 'Sunil'</sql>
    <sql>INSERT INTO pause (customer_id, days) SELECT id, 2 FROM customer WHERE name = 'Priya'</sql>
    <rollback><delete tableName="pause"/><delete tableName="customer"/></rollback>
  </changeSet>
</databaseChangeLog>
