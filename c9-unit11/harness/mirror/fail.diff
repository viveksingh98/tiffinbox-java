+/** THE HARNESS'S MIRROR CLASS (c9-unit11, harness/mirror/fail.diff), never TiffinBox's: six failing REST Docs tests, two per kind, one per order. */
+@ExtendWith(RestDocumentationExtension.class)
+@SpringBootTest(classes = TiffinBoxApp.class, properties = "tiffinbox.shutdown-token=not-the-real-token")
+class FailureKindsProbeTest {
+    @Autowired WebApplicationContext ctx;
+    MockMvc mvc;
+
+    @BeforeEach
+    void setUp(RestDocumentationContextProvider rd) {
+        mvc = MockMvcBuilders.webAppContextSetup(ctx).apply(documentationConfiguration(rd)).build();
+    }
+
+    static FieldDescriptor[] four() {
+        return new FieldDescriptor[] { fieldWithPath("name").description("name"), fieldWithPath("mealsPerDay").description("meals"),
+            fieldWithPath("pricePerMeal").description("price"), fieldWithPath("mealType").description("type") };
+    }
+    static FieldDescriptor[] withNickname() {
+        return new FieldDescriptor[] { fieldWithPath("name").description("name"), fieldWithPath("mealsPerDay").description("meals"),
+            fieldWithPath("pricePerMeal").description("price"), fieldWithPath("mealType").description("type"),
+            fieldWithPath("nickname").description("a field TiffinBox never sends") };
+    }
+    static FieldDescriptor[] withoutMealType() {
+        return new FieldDescriptor[] { fieldWithPath("name").description("name"), fieldWithPath("mealsPerDay").description("meals"),
+            fieldWithPath("pricePerMeal").description("price") };
+    }
+
+    @Test void statusA() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andExpect(status().isCreated()).andDo(document("status-a", responseFields(four())));
+    }
+    @Test void statusB() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andDo(document("status-b", responseFields(four()))).andExpect(status().isCreated());
+    }
+    @Test void neverSentA() throws Exception {
