+    @Test void neverSentB() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andDo(document("never-sent-b", responseFields(withNickname()))).andExpect(status().isOk());
+    }
+    @Test void undocumentedA() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andExpect(status().isOk()).andDo(document("undocumented-a", responseFields(withoutMealType())));
+    }
+    @Test void undocumentedB() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andDo(document("undocumented-b", responseFields(withoutMealType()))).andExpect(status().isOk());
+    }
