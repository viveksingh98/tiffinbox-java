+/** THE HARNESS'S MIRROR CLASS (c9-unit11, harness/mirror/accept.diff), never TiffinBox's: the public read documented under three Accepts. */
+@ExtendWith(RestDocumentationExtension.class)
+@SpringBootTest(classes = TiffinBoxApp.class, properties = "tiffinbox.shutdown-token=not-the-real-token")
+class AcceptProbeTest {
+    @Autowired WebApplicationContext ctx;
+    MockMvc mvc;
+
+    @BeforeEach
+    void setUp(RestDocumentationContextProvider rd) {
+        mvc = MockMvcBuilders.webAppContextSetup(ctx).apply(documentationConfiguration(rd)).build();
+    }
+
+    /** the generated client's Accept, as the receipt read it off the generated ApiApi source and wrote it to u11-accept.txt (the harness's file) */
+    static String generated() throws Exception {
+        try (java.io.InputStream in = AcceptProbeTest.class.getResourceAsStream("/u11-accept.txt")) {
+            return new String(in.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8).strip();
+        }
+    }
+
+    @Test void noAccept() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi")).andExpect(status().isOk()).andDo(document("accept-none"));
+    }
+    @Test void generatedClientsAccept() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi").header("Accept", generated())).andExpect(status().isOk()).andDo(document("accept-generated"));
+    }
+    @Test void json() throws Exception {
+        mvc.perform(get("/api/v1/customers/Ravi").header("Accept", "application/json")).andExpect(status().isOk()).andDo(document("accept-json"));
+    }
+}
