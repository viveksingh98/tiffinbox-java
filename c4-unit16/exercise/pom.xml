<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tiffinbox</groupId>
  <artifactId>c4-unit16-exercise</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Validation with Jakarta Bean Validation</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <h2.version>2.5.250</h2.version>
  </properties>

  <!--
    This course has no framework parent POM to inherit, so the track's rule "pin the parent,
    never the library" is applied one level down: ONE version number, here in
    dependencyManagement, moves the whole framework together. Every Spring artefact below
    therefore carries no <version> of its own.
    Read the resolved numbers off `mvn dependency:tree`, never off a slide - a documentation
    endpoint for this framework currently reports the version BELOW this one as current.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-framework-bom</artifactId>
        <version>7.0.9</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- @PostConstruct / @PreDestroy. Jakarta Annotations 3.0.0, pinned exactly: no BOM
         covers it, and it is not transitive from spring-context. -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <version>3.0.0</version>
    </dependency>
    <!-- No <version>. The BOM above decided it. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>
    <!--
      Hibernate Validator 9.1.3.Final. jakarta.validation-api arrives TRANSITIVELY at 3.1.1 and is
      deliberately NOT declared here: declaring it would pin a version this unit did not choose.
      Run `mvn dependency:tree` and read it off there.
    -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>9.1.3.Final</version>
    </dependency>
    <!--
      THE EL LAYER IS NOT HERE, AND THAT IS THE UNIT.
      hibernate-validator-9.1.3.Final.pom declares jakarta.el-api as `provided` + `optional`, so
      NOTHING brings an EL implementation transitively. Activate the `el` profile below to add it.
      One flag between "with" and "without" is what makes the pair a measurement.
    -->
  </dependencies>

  <profiles>
    <!-- mvn -Pel …  adds the EL API and an implementation of it. jakarta.el-api 6.0.1 is the GA
         (6.1.0-M1/M2 are milestones) and expressly 6.0.0 is the implementation - note that
         expressly 6.0.1 does not exist on Central at all. -->
    <profile>
      <id>el</id>
      <dependencies>
        <dependency>
          <groupId>jakarta.el</groupId>
          <artifactId>jakarta.el-api</artifactId>
          <version>6.0.1</version>
        </dependency>
        <dependency>
          <groupId>org.glassfish.expressly</groupId>
          <artifactId>expressly</artifactId>
          <version>6.0.0</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
