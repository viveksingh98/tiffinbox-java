<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    THE TWO LISTS OF VERSIONS - the course's, never TiffinBox's. It builds nothing: Maven's dependency plugin copies two files
    into target/boms, by exact version - Boot's own list of the versions it manages (its BOM, spring-boot-dependencies), as the
    last Boot 3 shipped it (3.5.16) and as this course's Boot ships it (4.1.1). The parent only supplies the plugin's version.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>harness</groupId>
  <artifactId>boot-version-lists</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>boms</id>
            <phase>validate</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/boms</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-dependencies</artifactId>
                  <version>3.5.16</version>
                  <type>pom</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-dependencies</artifactId>
                  <version>4.1.1</version>
                  <type>pom</type>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
