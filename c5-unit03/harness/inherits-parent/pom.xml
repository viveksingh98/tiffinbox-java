<?xml version="1.0" encoding="UTF-8"?>
<!-- Boot's version list arrives by INHERITANCE: the parent is spring-boot-starter-parent, whose own parent is
     spring-boot-dependencies. This file and ../imports-bom/pom.xml differ in that one respect (and their artifactId);
     both set the same property and name the same dependency without a version. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.tiffinbox</groupId>
  <artifactId>inherits-parent</artifactId>
  <version>1.0.0</version>
  <properties>
    <jackson-2-bom.version>2.22.2</jackson-2-bom.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
