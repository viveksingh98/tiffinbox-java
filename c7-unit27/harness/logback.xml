<configuration>
  <!-- Unit 27's harness (unit 26's form): one line per event - level, thread, logger, message - and no stack trace (%nopex: the
       harness prints an exception's class, message and causes itself). The thread is printed: the race's two edits run on threads
       named A and B, and the order of their lines is read off the capture (S4.18). Hibernate's SQL logger (DEBUG) and its bind
       logger (TRACE: each value an UPDATE binds - the new version in the SET, the old one in the where clause); Boot's
       JpaTransactionManager at DEBUG (S4.1's first witness); Hibernate's core logger at INFO for HHH000001 (S4.13); the
       EntityManagerFactory's bean and Spring Data's scan at INFO; the rest at WARN. -->
  <appender name="O" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level [%thread] %logger : %msg%n%nopex</pattern></encoder>
  </appender>
  <logger name="org.hibernate.SQL" level="DEBUG"/>
  <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
  <logger name="org.springframework.orm.jpa.JpaTransactionManager" level="DEBUG"/>
  <logger name="org.hibernate.orm.core" level="INFO"/>
  <logger name="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean" level="INFO"/>
  <logger name="org.springframework.data.repository.config.RepositoryConfigurationDelegate" level="INFO"/>
  <root level="WARN"><appender-ref ref="O"/></root>
</configuration>
