<configuration>
  <!-- Unit 39's harness: one line per event - level, thread, logger, message - and no stack trace (%nopex: the harness prints an
       exception's class, message and causes itself). Hibernate's SQL logger at DEBUG, so every statement Hibernate writes is a logged
       line; Hibernate's core logger from a run option (logging.level.org.hibernate.orm.core=info, for HHH000001); Flyway's loggers at
       INFO (a harness JVM runs with spring.flyway.enabled=false: loaded, disabled - its version line is the harness's); the rest at WARN. -->
  <appender name="O" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level [%thread] %logger : %msg%n%nopex</pattern></encoder>
  </appender>
  <logger name="org.flywaydb" level="INFO"/>
  <logger name="org.hibernate.SQL" level="DEBUG"/>
  <root level="WARN"><appender-ref ref="O"/></root>
</configuration>
